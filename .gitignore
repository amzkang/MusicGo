# 根目录只提交发布所需内容；新增顶层目录时显式加入白名单。
# 本地工具链、缓存、数据、构建产物、个人报告与代理配置均保留在本机。
/*
!/.gitignore
!/README.md
!/CONTRIBUTING.md
!/LICENSE
!/LICENSE.*
!/NOTICE
!/THIRD_PARTY_NOTICES.md
!/go.mod
!/go.sum
!/mygo.json
!/.github/
!/cmd/
!/internal/
!/docs/

# 本地代理与工作流说明，不随源码发布（匹配任意大小写和目录）。
[Aa][Gg][Ee][Nn][Tt][Ss].[Mm][Dd]
[Cc][Oo][Dd][Ee].[Mm][Dd]
[Aa][Gg][Aa][Ii][Nn][Ss][Tt].[Mm][Dd]
[Cc][Ll][Aa][Uu][Dd][Ee].[Mm][Dd]

# 只发布主程序，独立的动效演示留在本地。
/cmd/*
!/cmd/musicgo/
/internal/ui/prototypes/
/internal/ui/preview_*.png
/internal/ui/mygo_native_preview.png

# 保留维护文档和引用的图表；调研报告、旧设计稿与 HTML 原型不发布。
/docs/*
!/docs/README.md
!/docs/ARCHITECTURE.md
!/docs/FEATURES.md
!/docs/PLAYBACK_QUEUE.md
!/docs/diagrams/
!/docs/images/
/docs/images/*.svg

# 项目约定：不提交测试、夹具、覆盖率与性能采样产物。
*_test.go
test_*.py
*_test.py
*.test.*
*.spec.*
test/
tests/
testdata/
fixtures/
__snapshots__/
coverage/
coverage.*
*.coverprofile
*.test
*.prof
*.pprof

# 即使放入源码目录，也不提交本地依赖、配置、凭据和运行数据。
node_modules/
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.log
*.tmp
*.bak
*.exe
*.exe~
*.dll
*.so
*.dylib
.DS_Store
Thumbs.db
.idea/
.vscode/
__pycache__/
*.pyc
*.swp
*.swo
*~
