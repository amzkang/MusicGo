flowchart TB
    subgraph MAIN["主线程（MyGo / GTK 事件循环）"]
        direction TB
        M1["绘制界面<br/><i>ui.Context · Element</i>"]
        M2["只读内存状态<br/><i>store 缓存 / engine 快照</i>"]
        M3["轻量事件处理<br/><i>切页 · 选中 · 拖拽</i>"]
    end

    subgraph WORK["后台 Goroutine（绝不阻塞界面）"]
        direction TB
        W1["插件 JS 执行<br/><i>goja eventloop</i>"]
        W2["网络请求<br/><i>axios polyfill / ffprobe</i>"]
        W3["音频解码与播放<br/><i>ffmpeg 管道 / mygo audio</i>"]
        W4["SQLite 写入<br/><i>history / favorites / playlists</i>"]
        W5["封面下载与解码<br/><i>ImageCache</i>"]
        W6["LRC 解析<br/><i>lyric.Parse</i>"]
    end

    subgraph SYNC["跨线程同步机制"]
        direction TB
        S1["sync.RWMutex<br/><i>store 缓存 / engine 状态</i>"]
        S2["事件总线<br/><i>Add*Listener 扇出</i>"]
        S3["epoch 世代号<br/><i>丢弃过期任务结果</i>"]
        S4["requestRedraw<br/><i>合并重绘请求</i>"]
    end

    M1 <--> S1
    M3 --> S4
    S4 --> M1
    W1 --> S2
    W2 --> S2
    W3 --> S2
    W4 --> S1
    W5 --> S4
    W6 --> S1
    S2 --> M1
    S3 --> W1

